# Digisolar - Environment Variables Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AIRTABLE CONFIGURATION
# =============================================================================
# Get your API key from: https://airtable.com/account
# Get your Base ID from: https://airtable.com/api (select your base)
VITE_AIRTABLE_API_KEY=your_airtable_api_key_here
VITE_AIRTABLE_BASE_ID=your_airtable_base_id_here
VITE_AIRTABLE_TABLE_NAME=Leads

# Alternative: Airtable Form ID (if using form submission instead of API)
# VITE_AIRTABLE_FORM_ID=your_form_id_here

# =============================================================================
# GOOGLE MAPS CONFIGURATION
# =============================================================================
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Frontend Forge Proxy (if using)
VITE_FRONTEND_FORGE_API_KEY=your_forge_api_key_here
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================
# Umami Analytics (privacy-friendly)
# Get from your Umami instance
VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.com
VITE_ANALYTICS_WEBSITE_ID=your_website_id_here

# Alternative: Google Analytics
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# OAUTH CONFIGURATION (if needed)
# =============================================================================
VITE_OAUTH_PORTAL_URL=https://oauth.example.com
VITE_APP_ID=your_app_id_here

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
VITE_SITE_URL=https://digisolar.it
VITE_SITE_NAME=Digisolar
VITE_CONTACT_EMAIL=info@digisolar.it
VITE_CONTACT_PHONE=+393472219505

# =============================================================================
# NOTES
# =============================================================================
# - All variables prefixed with VITE_ are exposed to the client
# - Never commit the .env file to version control
# - Update .env.example when adding new variables
# - Restart dev server after changing .env variables
